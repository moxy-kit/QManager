#!/bin/sh
# =============================================================================
# qmanager_cm_nmea_relay — NMEA UDP Relay Daemon
# =============================================================================
# Lightweight daemon that listens for NMEA 0183 sentences over UDP and writes
# the latest GPS fix as JSON to a state file. Designed for use with the
# gpsdRelay Android app — the phone sends NMEA data directly to this device
# over UDP, no router or gpsd daemon needed.
#
# Listener:
#   - socat UDP-RECV:<port>,reuseaddr STDOUT (preferred)
#   - BusyBox nc -lup <port> (fallback)
#
# NMEA sentences parsed:
#   $GPGGA / $GNGGA — lat, lon, altitude, satellites, HDOP, fix quality, time
#   $GPRMC / $GNRMC — speed (knots → km/h), date (for full ISO timestamp)
#
# Output: /tmp/cellmapper_gps_fix.json (atomic write via .tmp + mv)
# PID:    /var/run/qmanager_cm_nmea_relay.pid
#
# The state file includes an _epoch field (Unix timestamp of last write) so
# consumers can detect stale data.
#
# UCI config:
#   uci get quecmanager.cellmapper.nmea_udp_port  (default: 29998)
#
# Install location: /usr/bin/qmanager_cm_nmea_relay
# Dependencies:     socat or nc, awk
# =============================================================================

STATE_FILE="/tmp/cellmapper_gps_fix.json"
STATE_TMP="/tmp/cellmapper_gps_fix.json.tmp"
PID_FILE="/var/run/qmanager_cm_nmea_relay.pid"

# ---------------------------------------------------------------------------
# Logging — source qlog if available, otherwise use stubs
# ---------------------------------------------------------------------------
if [ -f "/usr/lib/qmanager/qlog.sh" ]; then
    # shellcheck disable=SC1091
    . /usr/lib/qmanager/qlog.sh
    qlog_init "cm_nmea_relay"
fi
command -v qlog_info  >/dev/null 2>&1 || qlog_info()  { logger -t cm_nmea_relay "$*"; }
command -v qlog_warn  >/dev/null 2>&1 || qlog_warn()  { logger -t cm_nmea_relay "WARN: $*"; }
command -v qlog_error >/dev/null 2>&1 || qlog_error() { logger -t cm_nmea_relay "ERROR: $*"; }
command -v qlog_debug >/dev/null 2>&1 || qlog_debug() { :; }

# ---------------------------------------------------------------------------
# Read UDP port from UCI (default 29998)
# ---------------------------------------------------------------------------
if command -v uci >/dev/null 2>&1; then
    UDP_PORT=$(uci -q get quecmanager.cellmapper.nmea_udp_port 2>/dev/null)
fi
UDP_PORT="${UDP_PORT:-29998}"

# ---------------------------------------------------------------------------
# Determine listener command (socat preferred, nc fallback)
# ---------------------------------------------------------------------------
LISTENER_PID=""

if command -v socat >/dev/null 2>&1; then
    LISTENER_CMD="socat"
elif command -v nc >/dev/null 2>&1; then
    LISTENER_CMD="nc"
else
    qlog_error "Neither socat nor nc is available — cannot listen for NMEA data"
    exit 1
fi

# ---------------------------------------------------------------------------
# Clean shutdown handler
# ---------------------------------------------------------------------------
cleanup() {
    qlog_info "Shutting down NMEA UDP relay"
    if [ -n "$LISTENER_PID" ]; then
        kill "$LISTENER_PID" 2>/dev/null
        wait "$LISTENER_PID" 2>/dev/null
    fi
    rm -f "$STATE_FILE" "$STATE_TMP" "$PID_FILE"
    exit 0
}

trap cleanup INT TERM

# ---------------------------------------------------------------------------
# Write PID file
# ---------------------------------------------------------------------------
echo $$ > "$PID_FILE"

qlog_info "Starting NMEA UDP relay on port $UDP_PORT (listener: $LISTENER_CMD)"

# ---------------------------------------------------------------------------
# AWK parser for NMEA sentences
# ---------------------------------------------------------------------------
# This awk script processes GGA and RMC sentences and writes atomic JSON.
# It avoids jq in the hot path for performance on embedded devices.
#
# Variables maintained across lines:
#   lat, lon, alt, sats, fix_type, hdop, speed_kmh, iso_time, rmc_date
#
# On each valid GGA sentence, the state file is written (GGA has the most
# complete position data). RMC updates speed and date fields.
# ---------------------------------------------------------------------------

NMEA_AWK='
BEGIN {
    FS = ","
    lat = 0; lon = 0; alt = 0; sats = 0
    fix_type = "none"; hdop = 99.9; speed_kmh = 0
    iso_time = ""; rmc_date = ""
    state_file = ENVIRON["STATE_FILE"]
    state_tmp  = ENVIRON["STATE_TMP"]
}

# Convert NMEA DDDMM.mmmm to decimal degrees
function nmea_to_dec(raw, hemi,    int_part, dec_frac, deg, min_val, result) {
    if (raw == "" || raw + 0 == 0) return 0
    # Split at decimal point
    int_part = int(raw)
    dec_frac = raw - int_part
    # Last two digits of integer part are minutes
    deg = int(int_part / 100)
    min_val = (int_part - deg * 100) + dec_frac
    result = deg + min_val / 60.0
    if (hemi == "S" || hemi == "W") result = -result
    return result
}

# Write state file atomically
function write_state() {
    # Get current epoch
    cmd = "date +%s"
    cmd | getline epoch
    close(cmd)

    printf "{\"lat\":%.6f,\"lon\":%.6f,\"alt\":%.1f,\"sats\":%d,\"fix_type\":\"%s\",\"hdop\":%.1f,\"speed_kmh\":%.1f,\"time\":\"%s\",\"_epoch\":%s}\n", \
        lat, lon, alt, sats, fix_type, hdop, speed_kmh, iso_time, epoch > state_tmp
    close(state_tmp)

    system("mv " state_tmp " " state_file)
}

# --- GGA sentence: position, altitude, satellites, HDOP ---
$1 ~ /^\$G[PNLB]GGA$/ {
    # Validate minimum field count
    if (NF < 10) next

    # Field 7 = fix quality (0=no fix, 1=GPS, 2=DGPS, etc.)
    quality = $7 + 0
    if (quality < 1) next

    # Parse UTC time (HHMMSS.ss)
    utc = $2
    if (length(utc) >= 6) {
        hh = substr(utc, 1, 2)
        mm = substr(utc, 3, 2)
        ss = substr(utc, 5, 2)
    }

    # Parse coordinates
    lat = nmea_to_dec($3, $4)
    lon = nmea_to_dec($5, $6)

    # Satellites, HDOP, altitude
    sats = $8 + 0
    hdop = ($9 != "") ? $9 + 0 : 99.9
    alt  = ($10 != "") ? $10 + 0 : 0

    # Determine fix type from satellite count
    if (sats >= 4) fix_type = "3D"
    else if (sats >= 3) fix_type = "2D"
    else fix_type = "none"

    # Build ISO timestamp
    if (rmc_date != "" && length(rmc_date) == 6) {
        dd = substr(rmc_date, 1, 2)
        mo = substr(rmc_date, 3, 2)
        yy = substr(rmc_date, 5, 2)
        iso_time = "20" yy "-" mo "-" dd "T" hh ":" mm ":" ss "Z"
    } else {
        # No RMC date yet — use date command for the date portion
        cmd = "date -u +%Y-%m-%d"
        cmd | getline today
        close(cmd)
        iso_time = today "T" hh ":" mm ":" ss "Z"
    }

    write_state()
    next
}

# --- RMC sentence: speed and date ---
$1 ~ /^\$G[PNLB]RMC$/ {
    # Validate minimum field count
    if (NF < 10) next

    # Field 3 = status: A=active, V=void
    if ($3 != "A") next

    # Field 8 = speed in knots → km/h
    if ($8 != "") {
        speed_kmh = ($8 + 0) * 1.852
    }

    # Field 10 = date DDMMYY
    if ($10 != "" && length($10) == 6) {
        rmc_date = $10
    }

    next
}
'

# ---------------------------------------------------------------------------
# Main loop — start the listener and pipe to awk
# ---------------------------------------------------------------------------
while :; do
    if [ "$LISTENER_CMD" = "socat" ]; then
        socat UDP-RECV:"$UDP_PORT",reuseaddr STDOUT 2>/dev/null | \
            STATE_FILE="$STATE_FILE" STATE_TMP="$STATE_TMP" awk "$NMEA_AWK" &
        LISTENER_PID=$!
    else
        # BusyBox nc: -l = listen, -u = UDP, -p = port
        # nc -lup exits after the first sender disconnects on some implementations,
        # so we wrap it in the while loop for automatic reconnect.
        nc -lup "$UDP_PORT" 2>/dev/null | \
            STATE_FILE="$STATE_FILE" STATE_TMP="$STATE_TMP" awk "$NMEA_AWK" &
        LISTENER_PID=$!
    fi

    qlog_debug "Listener started (PID=$LISTENER_PID)"

    # Wait for the listener to exit (socat should run indefinitely for UDP)
    wait "$LISTENER_PID" 2>/dev/null
    exit_code=$?

    # If we were signalled (cleanup trap), don't restart
    # trap will handle cleanup
    if [ $exit_code -gt 128 ]; then
        break
    fi

    qlog_warn "Listener exited (code=$exit_code), restarting in 2 seconds"
    sleep 2
done
