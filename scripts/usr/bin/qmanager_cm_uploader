#!/bin/sh
# =============================================================================
# qmanager_cm_uploader — CellMapper Batch Uploader (stub)
# =============================================================================
# Drains the CellMapper SQLite pending queue (/overlay/cellmapper/queue.db),
# batches payloads, and uploads them to the configured CellMapper endpoint
# (or custom URL). Records upload history in the archive table.
#
# This is a STUB. Full uploader logic will be implemented in PR 2.
# The stub exits cleanly so procd does not enter a respawn loop before
# the real implementation is deployed.
#
# Install location: /usr/bin/qmanager_cm_uploader
# Dependencies:     /usr/lib/qmanager/qlog.sh, /usr/lib/qmanager/cellmapper_db.sh,
#                   /usr/lib/qmanager/cellmapper_uci.sh, curl
# =============================================================================

# Source the logging library. If unavailable (e.g. during early install),
# define no-op stubs so the rest of this script stays safe.
# shellcheck disable=SC1091
. /usr/lib/qmanager/qlog.sh 2>/dev/null || {
    qlog_init() { :; }
    qlog_info() { :; }
    qlog_warn() { :; }
    qlog_error() { :; }
}

qlog_init "cm_uploader"
qlog_info "CellMapper uploader not yet configured — exiting"

# Stub exits 0 so procd records a clean exit rather than a failure.
# The respawn threshold (3600 5 5) will not be tripped by a clean exit,
# so this effectively means procd will NOT respawn the stub — intentional.
exit 0
